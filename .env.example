NODE_ENV=development
PORT=5000

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/task-manager

JWT_ACCESS_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_a_different_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECRET=replace_with_another_random_secret
CLIENT_URL=http://localhost:5173

REDIS_URL=redis://localhost:6379

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (local + live) ─────────────────────────────────────────
# Priority when EMAIL_PROVIDER=auto: RESEND_API_KEY → BREVO_API_KEY → SMTP
EMAIL_PROVIDER=auto

# RECOMMENDED — Resend (works locally and in production)
# 1) Create free account: https://resend.com
# 2) API Keys → Create API Key → paste below
# 3) Local test: use onboarding@resend.dev (can send to your Resend account email)
# 4) Live: verify your domain in Resend, then set EMAIL_FROM to that domain
RESEND_API_KEY=
EMAIL_FROM=BIWORKSPACE <onboarding@resend.dev>
# Live example after domain verify:
# EMAIL_FROM=BIWORKSPACE <noreply@your-verified-domain.com>
# (Your Resend account already has houseofchilli.pk verified — use that for sending to any inbox)

# Alternative — Brevo (Sendinblue): https://app.brevo.com → SMTP & API → API keys
BREVO_API_KEY=

# Fallback — cPanel / Gmail SMTP (often filtered by Gmail if SPF is wrong)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=tasksmtp@yourdomain.com
SMTP_PASS="your-mailbox-password"
