NODE_ENV=development
PORT=5000

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/task-manager

JWT_ACCESS_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_a_different_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECRET=replace_with_another_random_secret

# Local: http://localhost:5173
# Live (Vercel): https://task-management-system-frontend-z23.vercel.app
CLIENT_URL=http://localhost:5173

# Upstash Redis (required for email queue + cache + chat-related jobs)
REDIS_ENABLED=true
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://<host>.upstash.io
UPSTASH_REDIS_REST_TOKEN=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (invites + forgot-password OTP) ─────────────────────────
# Prefer BI Communications SMTP (tasksmtp@bicommunications.ae)
EMAIL_PROVIDER=smtp

# From address must match the SMTP mailbox / verified domain
EMAIL_FROM=BIWORKSPACE <tasksmtp@bicommunications.ae>

# Optional Resend fallback (only if EMAIL_PROVIDER=resend or auto)
RESEND_API_KEY=
BREVO_API_KEY=

# BI Communications mailbox (SSL)
SMTP_HOST=mail.bicommunications.ae
SMTP_PORT=465
SMTP_USER=tasksmtp@bicommunications.ae
SMTP_PASS=

# ─── Google Sign-In ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local:  http://localhost:5000/api/v1/auth/google/callback
# Render: https://YOUR-SERVICE.onrender.com/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback
