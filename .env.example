# ─── App URLs (production must use the live frontend, not localhost) ─
# Local:  CLIENT_URL=http://localhost:5173
# Live (Render): CLIENT_URL=https://task-management-system-frontend-z23.vercel.app
# Google OAuth return URL is chosen dynamically from ?clientUrl= on /auth/google
# Optional override for email links if CLIENT_URL is wrong on the server:
# PUBLIC_APP_URL=https://task-management-system-frontend-z23.vercel.app
CLIENT_URL=http://localhost:5173

# ─── Email (invites + task/project notifications + forgot-password) ─
# Prefer Resend on Render (outbound SMTP / mail.bicomworkspace.com DNS fails there:
#   getaddrinfo EAI_AGAIN mail.bicomworkspace.com).
# Local can use SMTP; live MUST use Resend:
#   EMAIL_PROVIDER=resend
#   RESEND_API_KEY=re_...
#   EMAIL_FROM=BIWORKSPACE <noreply@bicomworkspace.com>
# Notification emails work without Redis: they send directly when the queue is off.
#
# CRITICAL — assignment emails to ANY member inbox:
# Until bicomworkspace.com shows Verified on Resend, Resend is in TEST MODE and can
# only deliver to the Resend account owner's address. Your 2nd Gmail / teammate inboxes
# will not receive task/project assignment mail. Fix (pick one):
#   1) Verify DNS at https://resend.com/domains  (recommended)
#   2) Set BREVO_API_KEY=xkeysib-... as fallback (sends to any recipient)
#   3) Local only: working SMTP_HOST (mail.bicomworkspace.com currently often fails DNS)
EMAIL_PROVIDER=resend
EMAIL_FROM="BIWORKSPACE <noreply@bicomworkspace.com>"
RESEND_API_KEY=
BREVO_API_KEY=

# Optional: Redis/BullMQ for queued emails. If false/missing, emails still send via sendMail().
REDIS_ENABLED=false

# cPanel mailbox — works locally; do NOT rely on this on Render:
SMTP_HOST=mail.bicomworkspace.com
SMTP_PORT=465
SMTP_USER=noreply@bicomworkspace.com
# Prefer base64 so special characters (#, &, etc.) are never truncated:
#   node -e "console.log(Buffer.from('YOUR_PASSWORD').toString('base64'))"
SMTP_PASS_B64=
SMTP_PASS=
#
# Resend DNS for bicomworkspace.com (LiquidWeb / cPanel → Zone Editor):
# Open https://resend.com/domains → bicomworkspace.com → add these exact records:
#   TXT  resend._domainkey  p=MIGf... (full value from Resend; must show verified)
#   MX   send               10 feedback-smtp.ap-northeast-1.amazonses.com
#   TXT  send               v=spf1 include:amazonses.com ~all
# Then click Verify. Status must be "verified" (currently "failed" = test mode).
# Check: node src/scripts/check-resend-domain.js
# Also add root SPF for cPanel SMTP if you use EMAIL_PROVIDER=smtp:
#   TXT  @                  v=spf1 a mx ip4:69.167.186.180 ~all
# After deploy: GET /health/email

# Superadmin seed (ensure-super-admin.js) — never commit real passwords
# SEED_SUPER_ADMIN_EMAIL=hamzaumar2033@gmail.com
# SEED_SUPER_ADMIN_PASSWORD=
# SEED_SUPER_ADMIN_NAME=Hamza Umar

# ─── OpenAI (Brain AI chat) ───────────────────────────────────────
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL_MAX=gpt-4o
# OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL_MAX=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
