# ─── Email (invites + forgot-password OTP) ─────────────────────────
# Official BIWORKSPACE mailbox — quote values with special characters
EMAIL_PROVIDER=smtp
EMAIL_FROM="BIWORKSPACE <noreply@bicomworkspace.com>"

RESEND_API_KEY=
BREVO_API_KEY=

SMTP_HOST=mail.bicomworkspace.com
SMTP_PORT=465
SMTP_USER=noreply@bicomworkspace.com
# Prefer base64 so special characters are never truncated:
#   node -e "console.log(Buffer.from('YOUR_PASSWORD').toString('base64'))"
SMTP_PASS_B64=
# Or quoted plain password (fragile on some hosts):
SMTP_PASS=
